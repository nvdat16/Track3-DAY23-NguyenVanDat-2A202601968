# LLM API key (required — pick one)
GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default model
# LLM_MODEL=gemini-2.5-flash

# Optional: real HITL interrupts (default: mock approval)
# LANGGRAPH_INTERRUPT=true

# PostgreSQL persistence (matches docker-compose.yml)
CHECKPOINTER=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/langgraph_lab

LOG_LEVEL=INFO
